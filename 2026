
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Amigo Oculto - Roleta</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #101020, #29204d);
  color: white;
}

.container {
  width: 100%;
  max-width: 480px;
  padding: 24px;
  text-align: center;
  background: #19192d;
  border: 1px solid #45456d;
  border-radius: 22px;
  box-shadow: 0 12px 40px #0007;
}

h1 {
  color: #b8a5ff;
}

p {
  color: #c9c9df;
  line-height: 1.5;
}

input {
  width: 100%;
  padding: 14px;
  margin: 7px 0;
  border: 1px solid #505075;
  border-radius: 10px;
  background: #101020;
  color: white;
  font-size: 16px;
}

button {
  width: 100%;
  padding: 14px;
  margin-top: 12px;
  border: none;
  border-radius: 10px;
  background: #8065ff;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #987fff;
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.hidden {
  display: none !important;
}

.counter {
  padding: 12px;
  margin: 16px 0;
  background: #292943;
  border-radius: 10px;
}

.wheel-container {
  position: relative;
  width: min(100%, 340px);
  margin: 25px auto;
}

canvas {
  width: 100%;
  height: auto;
  display: block;
}

.pointer {
  position: absolute;
  top: -8px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 17px solid transparent;
  border-right: 17px solid transparent;
  border-top: 32px solid white;
}

.result {
  padding: 18px;
  margin-top: 18px;
  border: 1px solid #7964d8;
  border-radius: 12px;
  background: #292943;
  color: #ffe27a;
  font-size: 21px;
  font-weight: bold;
  overflow-wrap: anywhere;
}

.list {
  text-align: left;
  padding-left: 28px;
  color: #deddf5;
}

.list li {
  padding: 5px 0;
}

.small {
  font-size: 12px;
  color: #9999b7;
}
</style>
</head>

<body>
<div class="container">

  <!-- INÍCIO -->
  <section id="home">
    <h1>🎁 Amigo Oculto</h1>

    <p>
      Crie sua conta, participe do sorteio
      e descubra quem é seu amigo oculto!
    </p>

    <div class="counter">
      Participantes:
      <strong><span id="count">0</span>/5</strong>
    </div>

    <button id="createButton" onclick="showRegister()">
      Criar conta
    </button>

    <button onclick="showLogin()">
      Já tenho uma conta
    </button>

    <p class="small">
      Protótipo local: os dados ficam neste navegador.
    </p>
  </section>

  <!-- CADASTRO -->
  <section id="register" class="hidden">
    <h1>📝 Criar conta</h1>

    <form id="registerForm">
      <input
        id="username"
        placeholder="Seu nome de usuário"
        maxlength="25"
        autocomplete="off"
        required
      >

      <input
        id="character"
        placeholder="Nome do seu personagem"
        maxlength="25"
        autocomplete="off"
        required
      >

      <input
        id="password"
        type="password"
        placeholder="Crie uma senha"
        minlength="4"
        maxlength="50"
        required
      >

      <button type="submit">Criar conta</button>
    </form>

    <button onclick="showHome()">Voltar</button>
  </section>

  <!-- LOGIN -->
  <section id="login" class="hidden">
    <h1>🔑 Entrar</h1>

    <form id="loginForm">
      <input
        id="loginUsername"
        placeholder="Nome de usuário"
        autocomplete="username"
        required
      >

      <input
        id="loginPassword"
        type="password"
        placeholder="Senha"
        autocomplete="current-password"
        required
      >

      <button type="submit">Entrar</button>
    </form>

    <button onclick="showHome()">Voltar</button>
  </section>

  <!-- JOGO -->
  <section id="game" class="hidden">
    <h1>🎡 Roleta do Amigo Oculto</h1>

    <p id="welcome"></p>

    <div class="counter">
      Participantes cadastrados:
      <strong><span id="gameCount">0</span>/5</strong>
    </div>

    <p id="instructions">
      Quando todos os participantes estiverem cadastrados,
      o sorteio poderá começar.
    </p>

    <div class="wheel-container">
      <div class="pointer"></div>
      <canvas id="wheel" width="600" height="600"></canvas>
    </div>

    <button id="drawButton" onclick="drawSecretSanta()">
      SORTEAR AMIGO OCULTO
    </button>

    <div id="result" class="result hidden"></div>

    <button id="revealButton" class="hidden"
      onclick="revealMyResult()">
      Revelar meu amigo oculto
    </button>

    <button onclick="logout()">Sair da conta</button>
  </section>

</div>

<script>
const MAX_USERS = 5;
const STORAGE_KEY = "amigo_oculto_roleta_v1";

const colors = [
  "#7657ff",
  "#e64e86",
  "#258fce",
  "#e5a52e",
  "#28a77a"
];

let data = loadData();
let currentUserId = null;
let spinning = false;
let rotation = 0;
let selectedIndex = 0;
let resultRevealed = false;

function loadData() {
  try {
    const saved = JSON.parse(
      localStorage.getItem(STORAGE_KEY) || "{}"
    );

    return {
      users: Array.isArray(saved.users) ? saved.users : [],
      assignments: saved.assignments || null
    };
  } catch {
    return { users: [], assignments: null };
  }
}

function saveData() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

function showSection(id) {
  document.querySelectorAll(".container section")
    .forEach(section => section.classList.add("hidden"));

  document.getElementById(id).classList.remove("hidden");
}

function currentUser() {
  return data.users.find(u => u.id === currentUserId) || null;
}

function showHome() {
  document.getElementById("count").textContent =
    data.users.length;

  const button = document.getElementById("createButton");

  button.disabled = data.users.length >= MAX_USERS;
  button.textContent = button.disabled
    ? "Limite de contas atingido"
    : "Criar conta";

  showSection("home");
}

function showRegister() {
  data = loadData();

  if (data.users.length >= MAX_USERS) {
    alert("O limite de cinco contas foi atingido.");
    showHome();
    return;
  }

  showSection("register");
}

function showLogin() {
  showSection("login");
}

// Cadastro
document.getElementById("registerForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    data = loadData();

    if (data.users.length >= MAX_USERS) {
      alert("Não há mais vagas.");
      showHome();
      return;
    }

    const username = document.getElementById("username")
      .value.trim();

    const character = document.getElementById("character")
      .value.trim();

    const password = document.getElementById("password")
      .value;

    if (!username || !character || password.length < 4) {
      alert("Confira os campos preenchidos.");
      return;
    }

    if (data.users.some(u =>
      u.username.toLowerCase() === username.toLowerCase()
    )) {
      alert("Este nome de usuário já existe.");
      return;
    }

    if (data.users.some(u =>
      u.character.toLowerCase() === character.toLowerCase()
    )) {
      alert("Este personagem já foi escolhido.");
      return;
    }

    // Esta senha é apenas demonstrativa.
    // Não use esta versão para senhas reais.
    const user = {
      id: crypto.randomUUID
        ? crypto.randomUUID()
        : String(Date.now()) + Math.random(),
      username,
      character,
      password
    };

    data.users.push(user);
    saveData();

    currentUserId = user.id;
    openGame();
  });

// Login
document.getElementById("loginForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    data = loadData();

    const username = document.getElementById("loginUsername")
      .value.trim();

    const password = document.getElementById("loginPassword")
      .value;

    const user = data.users.find(u =>
      u.username.toLowerCase() === username.toLowerCase() &&
      u.password === password
    );

    if (!user) {
      alert("Nome de usuário ou senha incorretos.");
      return;
    }

    currentUserId = user.id;
    openGame();
  });

function openGame() {
  const user = currentUser();

  if (!user) {
    showHome();
    return;
  }

  resultRevealed = false;
  showSection("game");

  document.getElementById("welcome").textContent =
    "Bem-vindo, " + user.username + "!";

  document.getElementById("gameCount").textContent =
    data.users.length;

  document.getElementById("result").classList.add("hidden");

  const result = document.getElementById("result");
  const drawButton = document.getElementById("drawButton");
  const revealButton = document.getElementById("revealButton");

  if (data.assignments) {
    drawButton.classList.add("hidden");
    revealButton.classList.remove("hidden");
    document.getElementById("instructions").textContent =
      "O sorteio foi realizado. Revele apenas o seu resultado.";
    drawWheel([]);
  } else {
    drawButton.classList.remove("hidden");
    revealButton.classList.add("hidden");

    document.getElementById("instructions").textContent =
      data.users.length < MAX_USERS
        ? "Aguardando todos os cinco participantes."
        : "Todos estão cadastrados. O sorteio está pronto.";

    drawButton.disabled = data.users.length !== MAX_USERS;
    drawWheel(data.users);
  }
}

function drawWheel(users) {
  const canvas = document.getElementById("wheel");
  const ctx = canvas.getContext("2d");
  const center = canvas.width / 2;
  const radius = center - 8;

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  if (users.length === 0) {
    ctx.beginPath();
    ctx.arc(center, center, radius, 0, Math.PI * 2);
    ctx.fillStyle = "#33334d";
    ctx.fill();

    ctx.fillStyle = "white";
    ctx.font = "bold 26px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(
      data.assignments ? "Sorteio realizado" : "Aguardando",
      center,
      center
    );

    return;
  }

  const slice = Math.PI * 2 / users.length;

  users.forEach((user, i) => {
    const start = -Math.PI / 2 + i * slice;
    const end = start + slice;

    ctx.beginPath();
    ctx.moveTo(center, center);
    ctx.arc(center, center, radius, start, end);
    ctx.closePath();
    ctx.fillStyle = colors[i % colors.length];
    ctx.fill();

    ctx.strokeStyle = "white";
    ctx.lineWidth = 3;
    ctx.stroke();

    ctx.save();
    ctx.translate(center, center);
    ctx.rotate(start + slice / 2);

    ctx.fillStyle = "white";
    ctx.font = "bold 23px Arial";
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";

    let name = user.character;

    while (
      ctx.measureText(name).width > radius * 0.65 &&
      name.length > 4
    ) {
      name = name.slice(0, -2) + "…";
    }

    ctx.fillText(name, radius - 22, 0);
    ctx.restore();
  });

  ctx.beginPath();
  ctx.arc(center, center, 42, 0, Math.PI * 2);
  ctx.fillStyle = "#19192d";
  ctx.fill();

  ctx.strokeStyle = "white";
  ctx.lineWidth = 4;
  ctx.stroke();

  ctx.fillStyle = "white";
  ctx.font = "bold 17px Arial";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("GIRAR", center, center);
}

// Cria um sorteio em que ninguém tira a si mesmo.
// Cada destinatário aparece exatamente uma vez.
function createAssignments() {
  const users = data.users;

  if (users.length !== MAX_USERS) {
    alert("São necessários cinco participantes.");
    return null;
  }

  const shuffled = [...users];

  // Embaralhamento aleatório.
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }

  // Tenta encontrar uma permutação sem ninguém tirar a si mesmo.
  // Se necessário, embaralha novamente.
  for (let attempt = 0; attempt < 10000; attempt++) {
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    const valid = users.every((user, index) =>
      user.id !== shuffled[index].id
    );

    if (valid) {
      const assignments = {};

      users.forEach((user, index) => {
        assignments[user.id] = shuffled[index].id;
      });

      return assignments;
    }
  }

  return null;
}

function drawSecretSanta() {
  if (spinning || data.assignments) return;

  if (data.users.length !== MAX_USERS) {
    alert("Aguardem os cinco participantes.");
    return;
  }

  const assignments = createAssignments();

  if (!assignments) {
    alert("Não foi possível realizar o sorteio. Tente novamente.");
    return;
  }

  spinning = true;

  const button = document.getElementById("drawButton");
  const canvas = document.getElementById("wheel");
  const ctx = canvas.getContext("2d");

  button.disabled = true;

  const startTime = performance.now();
  const duration = 4000;

  function animate(now) {
    const progress = Math.min(
      (now - startTime) / duration,
      1
    );

    const eased = 1 - Math.pow(1 - progress, 4);

    rotation = eased * 360 * 6;

    canvas.style.transform = "rotate(" + rotation + "deg)";

    if (progress < 1) {
      requestAnimationFrame(animate);
    } else {
      spinning = false;

      // Guarda o sorteio completo neste navegador.
      data.assignments = assignments;
      saveData();

      openGame();

      alert(
        "Sorteio concluído! Cada participante deve entrar " +
        "em sua própria conta para ver o resultado."
      );
    }
  }

  requestAnimationFrame(animate);
}

// Mostra apenas o resultado da conta conectada.
function revealMyResult() {
  const user = currentUser();

  if (!user || !data.assignments) {
    alert("O sorteio ainda não foi realizado.");
    return;
  }

  const recipientId = data.assignments[user.id];

  const recipient = data.users.find(u =>
    u.id === recipientId
  );

  if (!recipient) {
    alert("Não foi possível encontrar o resultado.");
    return;
  }

  const result = document.getElementById("result");

  result.textContent =
    "🎁 Seu amigo oculto é: " + recipient.character + "!";

  result.classList.remove("hidden");
  document.getElementById("revealButton").classList.add("hidden");
  resultRevealed = true;
}

function logout() {
  currentUserId = null;
  showHome();
}

function initialize() {
  document.getElementById("count").textContent =
    data.users.length;

  const button = document.getElementById("createButton");
  button.disabled = data.users.length >= MAX_USERS;

  if (button.disabled) {
    button.textContent = "Limite de contas atingido";
  }

  drawWheel(data.assignments ? [] : data.users);
}

initialize();
</script>
</body>
</html>
